.program i2s
.side_set 2

; 16-bit stereo I2S master for the PCM5102A, from GameConsoleV2 src/audio/i2s.pio. Side-set bit0 = BCK,
; bit1 = LRCK; 2 PIO cycles per bit, 64 per frame. Each 32-bit MSB-first FIFO word is (R << 16) | L.
bitloop1:
    out pins, 1       side 0b10
    jmp x-- bitloop1  side 0b11
    out pins, 1       side 0b00
    set x, 14         side 0b01
bitloop0:
    out pins, 1       side 0b00
    jmp x-- bitloop0  side 0b01
    out pins, 1       side 0b10
public entry_point:
    set x, 14         side 0b11
