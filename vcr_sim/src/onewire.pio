; onewire.pio -- generic single-wire bidirectional serial transport (half-duplex "1-wire" bus).
;
; One open-drain data line idles high via an external pull-up; either end pulses it low to send bits.
; Bits are pulse-width encoded in 1 us cells: 0 = long low + short high, 1 = short low + long high;
; a trailing stop bit (1) ends each direction. Matches N64/GameCube "joybus" but carries no protocol
; meaning. Open-drain via OPTIONAL side-set on PINDIRS: side 1 = pindir out (line pulled LOW), side 0
; = pindir in (released, pull-up takes it HIGH). TX FIFO: a count word (response bytes - 1) then the
; request bytes (MSB-justified). T1/T2 set the cell shape; clkdiv makes 4 PIO cycles == 1 us.

.program onewire
.side_set 1 opt pindirs
.define public T1 4
.define public T2 12

.wrap_target
  out y, 8 side 0 ; load # of bytes expected in response
  nop [7]
  nop [7]
  nop [7]
  nop [7]
sendData:
  out x, 1  side 0 [T1 - 1]; send data bit by bit
  jmp !x do_zero side 1 [T1 - 1] ; set 0 for 4 cycles
do_one:
  jmp !OSRE sendData side 0 [T1 * 2 - 1] ; set 1 for 10 cycles (the 6th cycle is on the out line above and jmp takes 1 cycle)
  jmp sendStop [T1 - 1]
do_zero:
  jmp !OSRE sendData [T1 * 2 - 1]; set 1 (the 2nd cycle is on the out line above and jmp takes 1 cycle)
  jmp sendStop side 0 [T1 - 1]
sendStop:
  nop side 1 [T1 - 1] ; send the stop bit (1)
  nop side 0

receiveByte:
  set x, 7
getBit:
  wait 0 pin 0 [T1 + 1]; wait until the line goes low, then wait until a 1 bit would register as high
  in pins 1 ; read
  wait 1 pin 0 ; wait for a 1 if it's a 0
  jmp x-- getBit ; get the next bit
  jmp y-- receiveByte ; get the next byte

.wrap


% c-sdk {
#include "hardware/clocks.h"
#include "hardware/pio.h"

// Configure one SM to drive a single GPIO as an open-drain 1-wire data line.
// `pin_data` is the side-set/out (pindir) pin, the IN pin, and the JMP pin.
static inline void onewire_program_init(PIO pio, uint sm, uint offset, uint pin_data, pio_sm_config *c) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin_data, 1, false);
    pio_gpio_init(pio, pin_data);

    sm_config_set_in_pins(c, pin_data);
    sm_config_set_sideset_pins(c, pin_data);
    sm_config_set_jmp_pin(c, pin_data);
    sm_config_set_out_shift(c, false, true, 8);
    sm_config_set_in_shift(c, false, true, 8);

    // 1 MHz bit-cell timebase regardless of clk_sys.
    int cyclesPerBit = (onewire_T1 + onewire_T2) / 4;
    float frequency = 1000000;
    float clockDiv = clock_get_hz(clk_sys) / (cyclesPerBit * frequency);
    sm_config_set_clkdiv(c, clockDiv);

    pio_sm_init(pio, sm, offset, c);
    pio_sm_set_enabled(pio, sm, true);
}

%}
